{
    "name": "super-kernel/exception-dispatcher",
    "description": "Attribute-driven exception handler discovery and dispatch for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "psr/container": "^2.0.2",
        "super-kernel/annotator": "dev-main",
        "super-kernel/attribute": "dev-main",
        "super-kernel/contract": "dev-main"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.3"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\ExceptionDispatcher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\ExceptionDispatcher\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
